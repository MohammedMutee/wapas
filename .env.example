# ── Wapas configuration ───────────────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env.

# Runtime mode: sim | live
#   sim  → virtual clock, simulated channels, no external network calls
#   live → real clock, real Razorpay test-mode API, real channel adapters
WAPAS_MODE=sim

# Database
DATABASE_URL=postgresql+psycopg://wapas:wapas@localhost:5433/wapas
REDIS_URL=redis://localhost:6380/0

# Anthropic (diagnosis + planning). Leave blank to run the rules-only path.
ANTHROPIC_API_KEY=
WAPAS_MODEL_REASONING=claude-opus-5
WAPAS_MODEL_CHEAP=claude-haiku-4-5-20251001
# Hard spend ceiling for a single eval run, in USD. Exceeding it aborts the run.
WAPAS_LLM_BUDGET_USD=15.0

# Razorpay TEST MODE ONLY. Keys must start with rzp_test_.
# The codebase refuses to start if a key starting with rzp_live_ is supplied.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Channels (optional; simulated adapters are used when blank)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
RESEND_API_KEY=

# Determinism
WAPAS_SEED=20260901
